# Backend only. Copy to .env.local in THIS workspace, then restart npm start.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini inference is enabled only for cover letters and interview coaching.
# All billing, notifications, protected resume APIs and other providers remain local.

# Optional Google OpenID Connect (backend only; no public env variables).
GOOGLE_CLIENT_ID=your_google_web_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:3210/api/auth/google/callback
# Development-only recovery inbox; never exposed by an HTTP download route.
LOCAL_AUTH_RECOVERY=true

# Optional standalone universal ATS service. Local only; never expose to browser.
ATS_INTERNAL_TOKEN=
ATS_DATABASE_URL=sqlite:///backend/ats-profiles.sqlite
